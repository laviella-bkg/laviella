# Para desarrollo local: `vercel env pull` trae DATABASE_URL y BLOB_READ_WRITE_TOKEN del proyecto.

# Payload CMS
# Postgres (Neon). En dev Payload sincroniza el esquema solo; en producción corre las migraciones de cms/migrations
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Secreto para firmar sesiones (cualquier string largo y aleatorio: `openssl rand -hex 32`)
PAYLOAD_SECRET=
# Token read/write del store de Vercel Blob donde se guardan las imágenes
BLOB_READ_WRITE_TOKEN=

# Emails (Gmail con App Password). Sin GMAIL_APP_PASSWORD los emails se escriben en la consola
# GMAIL_USER=laviella.domo@gmail.com
# GMAIL_APP_PASSWORD=
# ADMIN_NOTIFICATION_EMAIL=laviella.domo@gmail.com

# Google Calendar (opcional; sin estas variables la sincronización no hace nada)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=

# Tareas programadas: /api/cron exige `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=
# DRAFT_EXPIRY_HOURS=24
# AUTO_COMPLETE_RESERVATIONS=true

# URL base del sitio (links en emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp: número para el modal de consulta (sin + ni espacios, con código de país)
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000
